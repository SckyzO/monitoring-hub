.DS_Store
Thumbs.db
.directory

# --- Logs ---
*.log
logs/

# --- Python ---
__pycache__/
*.py[cod]
*.so
.venv/
.uv-cache/
.pre-commit-cache/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
coverage.xml

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Build Artifacts ---
index.html
catalog.json
build/
dist/
archives/
tmp/
site/
*.egg-info/
