# --- Secrets & Environment Variables ---
secrets/
.env
.env.local
gha-creds-*.json

# --- Documentation ---
# contains local POCs and raw architecture notes
ARCHITECTURE/

# --- AI Assistant Files ---
.claude/
.gemini/

# --- Local Custom Exporters ---
# The dev/ directory contains local binaries for testing/custom exporters.
# We ignore all files except documentation and example configs.
dev/*
!dev/*.md
!dev/*.yml.example
!dev/README.md

# --- GPG signing material (reproducible via scripts/generate_gpg_key.sh) ---
# secrets/ is already ignored above; these exact-name guards are defensive in case
# key material is ever exported outside secrets/ by mistake.
GPG_PRIVATE_KEY
GPG_PASSPHRASE
GPG_PUBLIC_KEY
# ephemeral gpg home used by the release pipeline / local dry-runs
.gnupg-ci/
