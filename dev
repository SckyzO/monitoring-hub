#!/usr/bin/env bash
set -euo pipefail

IMAGE="forge-dev"
UID_GID="$(id -u):$(id -g)"

# Env allowlist forwarded to the container (value-less so secrets stay off argv;
# unset vars are no-ops). Lets forge-release.yml sign + publish inside the
# container. ITEM (build-matrix item) and ACTOR (github.actor, for ghcr login)
# are not secrets but reach the container the same way.
ENV_ARGS=(
  -e GH_TOKEN -e GITHUB_TOKEN -e GNUPGHOME
  -e GPG_PRIVATE_KEY -e GPG_PASSPHRASE
  -e DOCKERHUB_USERNAME -e DOCKERHUB_TOKEN -e DOCKERHUB_NAMESPACE
  -e ITEM -e ACTOR
)

case "${1:-}" in
  build)
    docker build \
      --build-arg "USER_UID=$(id -u)" \
      --build-arg "USER_GID=$(id -g)" \
      -f Dockerfile.dev -t "${IMAGE}" .
    ;;
  shell)
    docker run --rm -it -u "${UID_GID}" \
      -v "$(pwd):/workspace" "${IMAGE}" bash
    ;;
  run)
    shift
    docker run --rm -u "${UID_GID}" \
      "${ENV_ARGS[@]}" \
      -v "$(pwd):/workspace" "${IMAGE}" "$@"
    ;;
  run-oci)
    shift
    # Rootless buildah must create a user namespace (unshare(CLONE_NEWUSER)) and
    # use clone/mount syscalls the default seccomp/apparmor profiles deny to a
    # non-CAP_SYS_ADMIN process. These two opts lift exactly that restriction and
    # are scoped to the OCI publish job ONLY -- `run`/`make ci` stay fully
    # confined. No --privileged, no docker socket, no /dev/fuse (vfs storage).
    docker run --rm -u "${UID_GID}" \
      --security-opt seccomp=unconfined \
      --security-opt apparmor=unconfined \
      "${ENV_ARGS[@]}" \
      -v "$(pwd):/workspace" "${IMAGE}" "$@"
    ;;
  *)
    echo "usage: ./dev {build|shell|run <cmd...>|run-oci <cmd...>}" >&2
    exit 2
    ;;
esac
