# syntax=docker/dockerfile:1
FROM python:3.12-slim

# Match the host user so files created in the mounted volume (.venv, caches,
# generated files) stay owned by the host user rather than root.
ARG USER_UID=1000
ARG USER_GID=1000

# git is required by pre-commit (hook repos + commit-msg stage);
# ca-certificates for HTTPS fetches by uv and pre-commit hooks;
# curl downloads the pinned nfpm release tarball below;
# libatomic1 is required by the Node runtime that pre-commit downloads for the
# markdownlint hook.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${USER_GID}" dev \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash dev

# SP2 distribution tooling, all from Debian packages:
#   createrepo-c   -> yum/RPM repo metadata (repodata/, repomd.xml)
#   rpm            -> rpmsign, to GPG-sign the built .rpm packages
#   debsigs        -> embed GPG signatures in the built .deb packages
#   apt-utils      -> apt-ftparchive, the stateless flat APT repo generator
#   buildah        -> daemonless, rootless OCI image build (no docker socket)
#   skopeo         -> copy/push OCI images + multi-arch manifests
#   gnupg          -> sign repo metadata (repomd.xml.asc, InRelease, Release.gpg)
#   qemu-user-static + binfmt-support -> cross-arch (arm64) emulation for buildah
#   uidmap         -> newuidmap/newgidmap, required for rootless buildah's
#                     user-namespace UID/GID mapping (see subuid/subgid below)
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    createrepo-c rpm debsigs apt-utils buildah skopeo gnupg qemu-user-static binfmt-support uidmap \
    && rm -rf /var/lib/apt/lists/* \
    && echo "dev:100000:65536" > /etc/subuid \
    && echo "dev:100000:65536" > /etc/subgid \
    && mkdir -p /etc/containers \
    && printf '[containers]\nnetns = "host"\n' > /etc/containers/containers.conf

# uv: the package manager.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# nfpm — RPM/DEB packager (replaces ~650 lines of Jinja). Pinned by version;
# tracked by scripts/check_update.py against goreleaser/nfpm releases.
ARG NFPM_VERSION=2.46.3
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
    amd64) nfpm_arch=x86_64 ;; \
    arm64) nfpm_arch=arm64 ;; \
    *) echo "unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_Linux_${nfpm_arch}.tar.gz" -o /tmp/nfpm.tgz; \
    tar -xzf /tmp/nfpm.tgz -C /usr/local/bin nfpm; \
    rm /tmp/nfpm.tgz; \
    nfpm --version

# gh — GitHub CLI, used by forge.publish.releases to create/upload GitHub
# Releases. Pinned by version; the tarball ships gh under bin/, so strip the
# leading version dir to land it at /usr/local/bin/gh.
ARG GH_VERSION=2.93.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
    amd64) gh_arch=amd64 ;; \
    arm64) gh_arch=arm64 ;; \
    *) echo "unsupported arch $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" -o /tmp/gh.tgz; \
    tar -xzf /tmp/gh.tgz -C /usr/local --strip-components=1 "gh_${GH_VERSION}_linux_${gh_arch}/bin/gh"; \
    rm /tmp/gh.tgz; \
    gh --version

# netavark + aardvark-dns — the container network stack buildah looks up when it
# creates the build container's namespace. Not packaged on Debian trixie, so
# install the upstream release binaries into /usr/lib/podman (one of buildah's
# helper_binaries_dir search paths). amd64 only: the dev image runs natively on
# amd64 in CI; arm64 images are produced via qemu emulation while these helpers
# still execute as amd64. Combined with netns=host above, the OCI publish job
# builds images without provisioning an isolated rootless network.
ARG NETAVARK_VERSION=2.0.0
ARG AARDVARK_VERSION=2.0.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    [ "$arch" = "amd64" ] || { echo "dev image only supports amd64 (got $arch)" >&2; exit 1; }; \
    mkdir -p /usr/lib/podman; \
    curl -fsSL "https://github.com/containers/netavark/releases/download/v${NETAVARK_VERSION}/netavark.gz" -o /tmp/netavark.gz; \
    curl -fsSL "https://github.com/containers/aardvark-dns/releases/download/v${AARDVARK_VERSION}/aardvark-dns.gz" -o /tmp/aardvark-dns.gz; \
    gunzip /tmp/netavark.gz /tmp/aardvark-dns.gz; \
    mv /tmp/netavark /usr/lib/podman/netavark; \
    mv /tmp/aardvark-dns /usr/lib/podman/aardvark-dns; \
    chmod 0755 /usr/lib/podman/netavark /usr/lib/podman/aardvark-dns; \
    /usr/lib/podman/netavark --version

WORKDIR /workspace

# Keep the venv and uv cache inside the mounted workspace so they persist across
# the ephemeral `docker run --rm` invocations of ./dev (both are gitignored).
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    UV_CACHE_DIR=/workspace/.uv-cache \
    PRE_COMMIT_HOME=/workspace/.pre-commit-cache \
    PATH="/workspace/.venv/bin:/usr/local/bin:${PATH}"

# Rootless buildah inside an unprivileged container: chroot isolation avoids the
# runc/cgroup setup that fails when nested, and the vfs storage driver avoids
# needing fuse-overlayfs + /dev/fuse. Combined with the subuid/subgid above and
# the seccomp/apparmor opts ./dev passes for `run-oci`, this lets the OCI publish
# job build cross-arch images without a docker socket or privileged mode.
ENV BUILDAH_ISOLATION=chroot \
    STORAGE_DRIVER=vfs

USER dev
